Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (10 cm)
      Cell Size: 0.1
      Plane Cell Count: 20
      Color: 160; 160; 164
      Alpha: 0.25
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: Robot
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Alpha: 1
      Value: true
    - Class: moveit_rviz_plugin/MotionPlanning
      Name: MotionPlanning
      Planned Path:
        Loop Animation: false
        State Display Time: 0.05 s
        Trajectory Topic: display_planned_path
      Planning Scene Topic: monitored_planning_scene
      Robot Description: robot_description
      Scene Robot:
        Robot Alpha: 0.5
      Value: false
    - Class: rviz_default_plugins/PointCloud2
      Name: Scene points
      Color Transformer: RGB8
      Style: Points
      Size (Pixels): 2
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scene_camera/points
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Wrist points
      Color Transformer: RGB8
      Style: Points
      Size (Pixels): 2
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /wrist_mounted_camera/points
      Value: true
    - Class: rviz_default_plugins/Axes
      Name: Wrist axes
      Reference Frame: camera_color_frame
      Length: 0.08
      Radius: 0.005
      Value: true
    - Class: rviz_default_plugins/Axes
      Name: Scene axes
      Reference Frame: scene_camera
      Length: 0.1
      Radius: 0.006
      Value: false
    - Class: rviz_default_plugins/Image
      Name: Wrist camera
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /wrist_mounted_camera/image
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Scene camera
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scene_camera/image
      Value: true
  Global Options:
    Fixed Frame: world
    Background Color: 48; 48; 48
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.0
      Focal Point:
        X: 0.35
        Y: -0.15
        Z: 0.05
      Name: Current View
      Pitch: 0.5
      Target Frame: world
      Yaw: 5.74
Window Geometry:
  Displays:
    collapsed: false
  Height: 1050
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 
  Scene camera:
    collapsed: false
  Width: 1800
  Wrist camera:
    collapsed: false
  X: 60
  Y: 60
