<?xml version="1.0"?>
<sdf version="1.9">
  <!-- Fixed RGB-D camera looking at the table, placed by sim.launch.py -->
  <model name="scene_camera">
    <static>true</static>
    <link name="link">
      <visual name="body">
        <geometry><box><size>0.04 0.10 0.03</size></box></geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
      <sensor name="scene_camera" type="rgbd_camera">
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.1</near><far>4</far></clip>
          <depth_camera><clip><near>0.1</near><far>2</far></clip></depth_camera>
        </camera>
        <gz_frame_id>scene_camera</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>5</update_rate>
        <visualize>true</visualize>
        <topic>scene_camera</topic>
      </sensor>
    </link>
  </model>
</sdf>
