<?xml version="1.0" ?>
<!-- Gazebo's empty world plus a table and a cube. The robot base is at the table top
     (z = 0.30 m), so in base_link the table surface is z = 0. -->
<sdf version="1.9">
  <world name="lab12">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Table under the robot and the work area, top at z = 0.30 m -->
    <model name="table">
      <static>true</static>
      <pose>0.325 -0.10 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.95 0.80 0.30</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.95 0.80 0.30</size></box></geometry>
          <material>
            <ambient>0.55 0.40 0.25 1</ambient>
            <diffuse>0.55 0.40 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Basket (place spot): centre (0.50, -0.30) in base_link, 18 cm inside, 5 cm high.
         No collision floor: the cube rests on the table. -->
    <model name="basket">
      <static>true</static>
      <pose>0.50 -0.30 0.30 0 0 0</pose>
      <link name="link">
        <collision name="wall_x_pos"><pose>0.095 0 0.025 0 0 0</pose><geometry><box><size>0.01 0.2 0.05</size></box></geometry></collision>
        <visual name="wall_x_pos"><pose>0.095 0 0.025 0 0 0</pose><geometry><box><size>0.01 0.2 0.05</size></box></geometry>
          <material><ambient>0.1 0.3 0.8 1</ambient><diffuse>0.1 0.3 0.8 1</diffuse></material>
        </visual>
        <collision name="wall_x_neg"><pose>-0.095 0 0.025 0 0 0</pose><geometry><box><size>0.01 0.2 0.05</size></box></geometry></collision>
        <visual name="wall_x_neg"><pose>-0.095 0 0.025 0 0 0</pose><geometry><box><size>0.01 0.2 0.05</size></box></geometry>
          <material><ambient>0.1 0.3 0.8 1</ambient><diffuse>0.1 0.3 0.8 1</diffuse></material>
        </visual>
        <collision name="wall_y_pos"><pose>0 0.095 0.025 0 0 0</pose><geometry><box><size>0.18 0.01 0.05</size></box></geometry></collision>
        <visual name="wall_y_pos"><pose>0 0.095 0.025 0 0 0</pose><geometry><box><size>0.18 0.01 0.05</size></box></geometry>
          <material><ambient>0.1 0.3 0.8 1</ambient><diffuse>0.1 0.3 0.8 1</diffuse></material>
        </visual>
        <collision name="wall_y_neg"><pose>0 -0.095 0.025 0 0 0</pose><geometry><box><size>0.18 0.01 0.05</size></box></geometry></collision>
        <visual name="wall_y_neg"><pose>0 -0.095 0.025 0 0 0</pose><geometry><box><size>0.18 0.01 0.05</size></box></geometry>
          <material><ambient>0.1 0.3 0.8 1</ambient><diffuse>0.1 0.3 0.8 1</diffuse></material>
        </visual>
        <visual name="floor">
          <pose>0 0 0.001 0 0 0</pose>
          <geometry><box><size>0.18 0.18 0.002</size></box></geometry>
          <material><ambient>0.6 0.75 1 1</ambient><diffuse>0.6 0.75 1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 5 cm, 50 g cube; (0.50, 0.00, 0.025) in base_link -->
    <model name="cube">
      <pose>0.50 0.00 0.325 0 0 0</pose>
      <!-- /model/cube/pose, used by grasp_fix.py -->
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_model_pose>true</publish_model_pose>
        <publish_link_pose>false</publish_link_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg>
        <update_frequency>50</update_frequency>
      </plugin>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>2.08e-5</ixx><iyy>2.08e-5</iyy><izz>2.08e-5</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <surface>
            <friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material>
            <ambient>0.8 0.1 0.1 1</ambient>
            <diffuse>0.8 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
